{
  "name": "typescript-design-patterns-handbook",
  "version": "0.1.0",
  "private": true,
  "description": "A practical TypeScript handbook for the 23 Gang of Four design patterns.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "factory-method": "tsx patterns/creational/factory-method/index.ts",
    "facade": "tsx patterns/structural/facade/index.ts",
    "iterator": "tsx patterns/behavioral/iterator/index.ts",
    "observer": "tsx patterns/behavioral/observer/index.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "validate": "npm run format:check && npm run check",
    "prepare": "husky",
    "adapter": "tsx patterns/structural/adapter/index.ts",
    "builder": "tsx patterns/creational/builder/index.ts",
    "command": "tsx patterns/behavioral/command/index.ts",
    "decorator": "tsx patterns/structural/decorator/index.ts",
    "singleton": "tsx patterns/creational/singleton/index.ts",
    "strategy": "tsx patterns/behavioral/strategy/index.ts",
    "template-method": "tsx patterns/behavioral/template-method/index.ts",
    "proxy": "tsx patterns/structural/proxy/index.ts",
    "composite": "tsx patterns/structural/composite/index.ts",
    "state": "tsx patterns/behavioral/state/index.ts",
    "chain-of-responsibility": "tsx patterns/behavioral/chain-of-responsibility/index.ts",
    "abstract-factory": "tsx patterns/creational/abstract-factory/index.ts",
    "prototype": "tsx patterns/creational/prototype/index.ts",
    "mediator": "tsx patterns/behavioral/mediator/index.ts",
    "bridge": "tsx patterns/structural/bridge/index.ts",
    "visitor": "tsx patterns/behavioral/visitor/index.ts",
    "memento": "tsx patterns/behavioral/memento/index.ts",
    "flyweight": "tsx patterns/structural/flyweight/index.ts",
    "interpreter": "tsx patterns/behavioral/interpreter/index.ts",
    "docs:sync": "node scripts/sync-docs-content.cjs",
    "docs:dev": "astro dev",
    "docs:build": "npm run docs:sync && astro build",
    "docs:preview": "astro preview",
    "validate:all": "npm run validate && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "astro": "^7.2.0",
    "marked": "^18.0.9"
  }
}
