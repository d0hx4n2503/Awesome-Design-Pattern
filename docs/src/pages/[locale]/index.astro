---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getPatterns } from "../../lib/content";
import { normalizeLocale, ui } from "../../lib/i18n";

export function getStaticPaths() {
  return ["en", "vi", "zh"].map((locale) => ({ params: { locale } }));
}

const locale = normalizeLocale(Astro.params.locale);
const t = ui[locale];
const patterns = getPatterns(locale);
const base = import.meta.env.BASE_URL;
---

<DocsLayout>
  <Fragment slot="title">Awesome Design Pattern · </Fragment>
  <section class="hero">
    <p class="eyebrow">Gang of Four · TypeScript · Tested</p>
    <h1>{t.heroTitle}</h1>
    <p>{t.heroBody}</p>
    <div class="hero-actions">
      <a class="button primary" href={`${base}${locale}/patterns/behavioral/strategy`}>Start with Strategy</a>
      <a class="button" href="https://github.com/d0hx4n2503/Awesome-Design-Pattern">GitHub</a>
    </div>
  </section>

  <section class="stats-grid">
    <article><strong>23</strong><span>GoF Patterns</span></article>
    <article><strong>23</strong><span>TypeScript Implementations</span></article>
    <article><strong>40+</strong><span>Test Cases</span></article>
    <article><strong>3</strong><span>Languages</span></article>
  </section>

  <section class="cards">
    {patterns.map((pattern) => (
      <a class="pattern-card" href={`${base}${pattern.href.slice(1)}`}>
        <span>{pattern.groupLabel}</span>
        <strong>{pattern.title}</strong>
        <small>{pattern.implementationPath}</small>
      </a>
    ))}
  </section>
</DocsLayout>
