---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getPatterns } from "../../lib/content";
import { normalizeLocale, ui } from "../../lib/i18n";

export function getStaticPaths() {
  return ["en", "vi", "zh"].map((locale) => ({ params: { locale } }));
}

const locale = normalizeLocale(Astro.params.locale);
const t = ui[locale];
const patterns = getPatterns(locale);
const base = import.meta.env.BASE_URL;
---

<DocsLayout>
  <Fragment slot="title">TypeScript Design Patterns Handbook · </Fragment>
  <section class="hero">
    <div class="hero-content">
      <p class="kicker">Gang of Four · TypeScript · Tested</p>
      <h1>{t.heroTitle}</h1>
      <p>{t.heroBody}</p>
      <div class="hero-actions">
        <a class="button primary" href={`${base}${locale}/patterns/behavioral/strategy`}>Start with Strategy</a>
        <a class="button" href="https://github.com/d0hx4n2503/typescript-design-patterns-handbook">View on GitHub</a>
      </div>
    </div>
  </section>

  <section class="stats-grid">
    <article><strong>23</strong><span>GoF Patterns</span></article>
    <article><strong>23</strong><span>TypeScript Implementations</span></article>
    <article><strong>40+</strong><span>Test Cases</span></article>
    <article><strong>3</strong><span>Languages</span></article>
  </section>

  <section class="section-heading">
    <div>
      <p class="eyebrow">Pattern catalog</p>
      <h2>Explore by implementation</h2>
    </div>
    <p>Each entry links to concise docs, TypeScript source, and mirrored tests so the pattern stays easy to study and verify.</p>
  </section>

  <section class="cards">
    {patterns.map((pattern) => (
      <a class="pattern-card" href={`${base}${pattern.href.slice(1)}`}>
        <span>{pattern.groupLabel}</span>
        <strong>{pattern.title}</strong>
        <small>{pattern.implementationPath}</small>
      </a>
    ))}
  </section>
</DocsLayout>
