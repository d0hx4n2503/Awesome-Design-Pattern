---
import "../styles/global.css";
import { localeLabels, locales, normalizeLocale, ui } from "../lib/i18n";
import { getPatterns } from "../lib/content";

const locale = normalizeLocale(Astro.params.locale);
const t = ui[locale];
const patterns = getPatterns(locale);
const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base.slice(0, -1) : base;
const currentPath = Astro.url.pathname.replace(basePath, "").replace(/^\/(en|vi|zh)/, "");
const groupedPatterns = patterns.reduce<Record<string, typeof patterns>>((groups, pattern) => {
  groups[pattern.groupLabel] ??= [];
  groups[pattern.groupLabel].push(pattern);
  return groups;
}, {});
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.tagline} />
    <title><slot name="title" />TypeScript Design Patterns Handbook</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme = savedTheme || (prefersDark ? "dark" : "light");
    </script>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-main">
        <a class="brand" href={`${base}${locale}/`} aria-label="TypeScript Design Patterns Handbook home">
          <span class="brand-symbol" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <strong>TS Patterns Handbook</strong>
        </a>

        <div class="search-wrap">
          <input id="pattern-search" class="search" type="search" placeholder={t.searchPlaceholder} />
        </div>

        <div class="header-actions">
          <label class="locale-control">
            <span>{t.language}</span>
            <select id="locale-select" aria-label={t.language}>
              {locales.map((item) => <option value={item} selected={item === locale}>{localeLabels[item]}</option>)}
            </select>
          </label>
          <button
            id="theme-toggle"
            class="icon-button"
            type="button"
            data-theme-label={t.theme}
            data-light-label={t.lightTheme}
            data-dark-label={t.darkTheme}
            aria-label={t.theme}
          >
            <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 4V2m0 20v-2m8-8h2M2 12h2m13.66-5.66 1.41-1.41M4.93 19.07l1.41-1.41m0-11.32L4.93 4.93m14.14 14.14-1.41-1.41M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
            </svg>
            <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 14.6A8.5 8.5 0 0 1 9.4 3 7 7 0 1 0 21 14.6Z" />
            </svg>
          </button>
        </div>
      </div>

      <nav class="topnav" aria-label="Documentation sections">
        <a href={`${base}${locale}/`}>Overview</a>
        <a href={`${base}${locale}/patterns/creational/factory-method/`}>Creational</a>
        <a href={`${base}${locale}/patterns/structural/adapter/`}>Structural</a>
        <a href={`${base}${locale}/patterns/behavioral/strategy/`}>Behavioral</a>
        <a href="https://github.com/d0hx4n2503/typescript-design-patterns-handbook">GitHub</a>
      </nav>
    </header>

    <div class="shell">
      <aside class="sidebar">
        <nav class="nav" aria-label={t.patterns}>
          {Object.entries(groupedPatterns).map(([group, items]) => (
            <section>
              <h2>{group}</h2>
              <ul>
                {items.map((pattern) => {
                  const href = `${base}${pattern.href.slice(1)}`;
                  return (
                    <li>
                      <a data-pattern-link href={href} class={Astro.url.pathname === href ? "active" : ""}>
                        {pattern.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </nav>
      </aside>

      <main class="content">
        <slot />
      </main>
    </div>

    <script src={`${base}scripts/site.js`}></script>
    <script is:inline define:vars={{ base, currentPath }}>
      document.getElementById("locale-select")?.addEventListener("change", (event) => {
        const nextLocale = event.target.value;
        window.location.href = `${base}${nextLocale}${currentPath}`;
      });
    </script>
  </body>
</html>
